# Supabase — values printed by `supabase start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Server-only, mirrors SUPABASE_SERVICE_KEY for runtimeConfig
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for Drizzle (server-side). Local default from `supabase status`.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NUXT_SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Veo camera analytics (specs/003-veo-analytics). Shared secret the
# production cron sends as `Authorization: Bearer ...` to POST /api/veo/sync.
# Never the club's Veo password/session — that lives in veo_sync_credentials.
NUXT_VEO_SYNC_SECRET=

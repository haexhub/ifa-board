{
  "name": "ifa-board",
  "version": "0.1.0",
  "private": true,
  "description": "Football team training points and photos — multi-tenant Nuxt + Supabase app",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "gen:types": "supabase gen types typescript --local > app/types/database.ts",
    "db:reset": "supabase db reset",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed:dummy": "tsx scripts/seed-dummy.ts"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^1.4.6",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@supabase/supabase-js": "^2.47.10",
    "@unovis/ts": "^1.5.1",
    "@unovis/vue": "^1.5.1",
    "@vueuse/core": "^12.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^3.14.1592",
    "postgres": "^3.4.9",
    "slug": "^10.0.0",
    "tailwind-merge": "^2.6.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nuxt/test-utils": "^3.15.4",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/slug": "^5.0.9",
    "@vue/test-utils": "^2.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^20.14.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "supabase": "^2.2.1",
    "tailwindcss": "^3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.0"
  }
}
